{
  "openapi": "3.1.0",
  "info": {
    "title": "Cropilot API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get Health",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Get Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/farms": {
      "get": {
        "tags": [
          "farms"
        ],
        "summary": "List Farms",
        "operationId": "list_farms",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FarmRead"
                  },
                  "type": "array",
                  "title": "Response List Farms"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "farms"
        ],
        "summary": "Create Farm",
        "operationId": "create_farm",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FarmCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FarmRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/regions": {
      "get": {
        "tags": [
          "regions"
        ],
        "summary": "List Regions",
        "description": "Public catalog: the departments a workspace can be scoped to.",
        "operationId": "list_regions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Region"
                  },
                  "type": "array",
                  "title": "Response List Regions"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace": {
      "get": {
        "tags": [
          "workspace"
        ],
        "summary": "Get Workspace",
        "description": "The signed-in user's workspace, or `null` until onboarding picks a region.",
        "operationId": "get_workspace",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/WorkspaceRead"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Workspace"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "workspace"
        ],
        "summary": "Save Workspace",
        "operationId": "save_workspace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceSave"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/water/strategies": {
      "get": {
        "tags": [
          "water"
        ],
        "summary": "Get Water Strategies",
        "description": "Shared Pergamino research scenarios; contains no user's farm records.",
        "operationId": "get_water_strategies",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategiesBundle"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/water/strategies/runs/{run_id}": {
      "get": {
        "tags": [
          "water"
        ],
        "summary": "Get Water Strategy Run",
        "description": "Daily series and crop stages for one released historical scenario.",
        "operationId": "get_water_strategy_run",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaterRunDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/crops/zones/{zone}/fields": {
      "get": {
        "tags": [
          "crops"
        ],
        "summary": "Get Crop Field Map",
        "description": "Every field of the zone with its crop per campaign and its vigor against the zone.",
        "operationId": "get_crop_field_map",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "zone",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "pergamino",
                "parana"
              ],
              "type": "string",
              "title": "Zone"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldMap"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CalendarEffect": {
        "properties": {
          "strategy_id": {
            "type": "string",
            "title": "Strategy Id"
          },
          "summer_shift_days": {
            "type": "integer",
            "title": "Summer Shift Days"
          },
          "deficit_difference": {
            "$ref": "#/components/schemas/DifferenceDistribution"
          }
        },
        "type": "object",
        "required": [
          "strategy_id",
          "summer_shift_days",
          "deficit_difference"
        ],
        "title": "CalendarEffect"
      },
      "CampaignRecord": {
        "properties": {
          "campaign": {
            "type": "string",
            "pattern": "^\\d{2}/\\d{2}$",
            "title": "Campaign"
          },
          "source": {
            "type": "string",
            "enum": [
              "INTA",
              "model"
            ],
            "title": "Source"
          },
          "crop_code": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 8.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Crop Code"
          },
          "crop": {
            "type": "string",
            "title": "Crop"
          },
          "purity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Purity"
          },
          "curve": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 9,
            "minItems": 9,
            "title": "Curve"
          },
          "phase_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "nino",
                  "nina",
                  "neutral"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase Code"
          },
          "phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase"
          },
          "oni": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oni"
          },
          "vigor": {
            "type": "number",
            "title": "Vigor"
          },
          "zone_vigor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone Vigor"
          },
          "gap": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gap"
          },
          "lag": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lag"
          },
          "even": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Even"
          },
          "zone_curve": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array",
                "maxItems": 9,
                "minItems": 9
              },
              {
                "type": "null"
              }
            ],
            "title": "Zone Curve"
          }
        },
        "type": "object",
        "required": [
          "campaign",
          "source",
          "crop_code",
          "crop",
          "purity",
          "curve",
          "phase_code",
          "phase",
          "oni",
          "vigor",
          "zone_vigor",
          "gap",
          "lag",
          "even",
          "zone_curve"
        ],
        "title": "CampaignRecord"
      },
      "CampaignWater": {
        "properties": {
          "start_year": {
            "type": "integer",
            "title": "Start Year"
          },
          "water_start_mm": {
            "type": "number",
            "title": "Water Start Mm"
          },
          "water_end_mm": {
            "type": "number",
            "title": "Water End Mm"
          },
          "crop_et_deficit_mm": {
            "type": "number",
            "title": "Crop Et Deficit Mm"
          }
        },
        "type": "object",
        "required": [
          "start_year",
          "water_start_mm",
          "water_end_mm",
          "crop_et_deficit_mm"
        ],
        "title": "CampaignWater"
      },
      "CropField": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Feature",
            "title": "Type"
          },
          "geometry": {
            "$ref": "#/components/schemas/PolygonGeometry"
          },
          "properties": {
            "$ref": "#/components/schemas/FieldProperties"
          }
        },
        "type": "object",
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "title": "CropField"
      },
      "CropResult": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "crop_id": {
            "type": "string",
            "title": "Crop Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "campaign_year": {
            "type": "integer",
            "title": "Campaign Year"
          },
          "sowing_date": {
            "type": "string",
            "title": "Sowing Date"
          },
          "end_date": {
            "type": "string",
            "title": "End Date"
          },
          "stage_lengths": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Stage Lengths"
          },
          "kc_initial": {
            "type": "number",
            "title": "Kc Initial"
          },
          "kc_mid": {
            "type": "number",
            "title": "Kc Mid"
          },
          "kc_end": {
            "type": "number",
            "title": "Kc End"
          },
          "depletion_fraction": {
            "type": "number",
            "title": "Depletion Fraction"
          },
          "water_at_sowing_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Water At Sowing Mm"
          },
          "et_potential_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Et Potential Mm"
          },
          "et_actual_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Et Actual Mm"
          },
          "crop_et_deficit_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Crop Et Deficit Mm"
          },
          "crop_days": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Crop Days"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/CropStage"
            },
            "type": "array",
            "title": "Stages"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "crop_id",
          "label",
          "campaign_year",
          "sowing_date",
          "end_date",
          "stage_lengths",
          "kc_initial",
          "kc_mid",
          "kc_end",
          "depletion_fraction",
          "water_at_sowing_mm",
          "et_potential_mm",
          "et_actual_mm",
          "crop_et_deficit_mm",
          "crop_days",
          "stages"
        ],
        "title": "CropResult"
      },
      "CropStage": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "initial",
              "development",
              "mid_season",
              "late_season"
            ],
            "title": "Stage"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "days": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Days"
          },
          "crop_et_deficit_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Crop Et Deficit Mm"
          },
          "stress_days": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stress Days"
          },
          "longest_stress_spell_days": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Longest Stress Spell Days"
          },
          "hot_days_above_35_c": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Hot Days Above 35 C"
          },
          "coincident_stress_heat_days": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Coincident Stress Heat Days"
          }
        },
        "type": "object",
        "required": [
          "stage",
          "start",
          "end",
          "days",
          "crop_et_deficit_mm",
          "stress_days",
          "longest_stress_spell_days",
          "hot_days_above_35_c",
          "coincident_stress_heat_days"
        ],
        "title": "CropStage"
      },
      "CurrentSeason": {
        "properties": {
          "campaign": {
            "type": "string",
            "pattern": "^\\d{2}/\\d{2}$",
            "title": "Campaign"
          },
          "phase_code": {
            "type": "string",
            "enum": [
              "nino",
              "nina",
              "neutral"
            ],
            "title": "Phase Code"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "strength": {
            "type": "string",
            "title": "Strength"
          },
          "oni": {
            "type": "number",
            "title": "Oni"
          }
        },
        "type": "object",
        "required": [
          "campaign",
          "phase_code",
          "phase",
          "strength",
          "oni"
        ],
        "title": "CurrentSeason"
      },
      "DailyWater": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "available_water_start_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Available Water Start Mm"
          },
          "precip_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Precip Mm"
          },
          "irrigation_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Irrigation Mm"
          },
          "eto_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Eto Mm"
          },
          "et_potential_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Et Potential Mm"
          },
          "et_actual_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Et Actual Mm"
          },
          "crop_et_deficit_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Crop Et Deficit Mm"
          },
          "excess_above_capacity_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Excess Above Capacity Mm"
          },
          "available_water_end_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Available Water End Mm"
          },
          "surface_depletion_end_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Surface Depletion End Mm"
          },
          "crop_event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crop Event Id"
          },
          "water_stress_coefficient": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Water Stress Coefficient"
          },
          "mass_residual_mm": {
            "type": "number",
            "title": "Mass Residual Mm"
          },
          "temperature_max_c": {
            "type": "number",
            "title": "Temperature Max C"
          }
        },
        "type": "object",
        "required": [
          "date",
          "available_water_start_mm",
          "precip_mm",
          "irrigation_mm",
          "eto_mm",
          "et_potential_mm",
          "et_actual_mm",
          "crop_et_deficit_mm",
          "excess_above_capacity_mm",
          "available_water_end_mm",
          "surface_depletion_end_mm",
          "crop_event_id",
          "water_stress_coefficient",
          "mass_residual_mm",
          "temperature_max_c"
        ],
        "title": "DailyWater"
      },
      "DifferenceDistribution": {
        "properties": {
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Count"
          },
          "minimum_mm": {
            "type": "number",
            "title": "Minimum Mm"
          },
          "median_mm": {
            "type": "number",
            "title": "Median Mm"
          },
          "maximum_mm": {
            "type": "number",
            "title": "Maximum Mm"
          },
          "lower_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Lower Count"
          },
          "equal_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Equal Count"
          },
          "higher_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Higher Count"
          }
        },
        "type": "object",
        "required": [
          "count",
          "minimum_mm",
          "median_mm",
          "maximum_mm",
          "lower_count",
          "equal_count",
          "higher_count"
        ],
        "title": "DifferenceDistribution"
      },
      "EnsoPhase": {
        "properties": {
          "phase_code": {
            "type": "string",
            "enum": [
              "nino",
              "nina",
              "neutral"
            ],
            "title": "Phase Code"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "oni": {
            "type": "number",
            "title": "Oni"
          }
        },
        "type": "object",
        "required": [
          "phase_code",
          "phase",
          "oni"
        ],
        "title": "EnsoPhase"
      },
      "FarmCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "FarmCreate"
      },
      "FarmRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "title": "FarmRead"
      },
      "FieldMap": {
        "properties": {
          "type": {
            "type": "string",
            "const": "FeatureCollection",
            "title": "Type"
          },
          "meta": {
            "$ref": "#/components/schemas/FieldMapMeta"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/CropField"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "type",
          "meta",
          "features"
        ],
        "title": "FieldMap"
      },
      "FieldMapMeta": {
        "properties": {
          "zone": {
            "type": "string",
            "enum": [
              "pergamino",
              "parana"
            ],
            "title": "Zone"
          },
          "lang": {
            "type": "string",
            "const": "en",
            "title": "Lang"
          },
          "campaigns": {
            "items": {
              "type": "string",
