{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/generated",
      "!**/routeTree.gen.ts",
      "!packages/api/openapi.json",
      "!apps/backend/app/modules/cases/resources",
      "!apps/mobile/assets",
      "!apps/backend/vendor",
      "!prototypes"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/webapp/src/components/ui/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/mobile/src/components/ui/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "on",
              "options": {
                "skip": [
                  "CardTitle",
                  "CardDescription",
                  "Label",
                  "SourceNote",
                  "SplitHeading"
                ]
              }
            }
          },
          "suspicious": {
            "noUnknownAtRules": {
              "level": "on",
              "options": {
                "ignore": ["tailwind"]
              }
            }
          }
        }
      }
    }
  ]
}
