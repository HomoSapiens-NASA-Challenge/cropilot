{
  "name": "cropilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "docker compose up -d --wait db && pnpm migrate && pnpm -r --parallel run dev",
    "mobile": "pnpm --filter @cropilot/mobile start",
    "migrate": "pnpm -r run migrate",
    "generate": "pnpm --filter @cropilot/backend run openapi && pnpm --filter @cropilot/api run generate",
    "lint": "biome check && pnpm -r run lint",
    "format": "biome check --write && pnpm -r run format",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "lefthook": "^2.2.2"
  }
}
