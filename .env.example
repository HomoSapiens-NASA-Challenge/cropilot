# Copy to `.env`. Never commit `.env`.

# --- Database ---
POSTGRES_USER=cropilot
POSTGRES_PASSWORD=cropilot
POSTGRES_DB=cropilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cropilot:cropilot@localhost:5432/cropilot

# --- Auth service (Better Auth) ---
AUTH_PORT=3000
# Public origin of the app. In development it is the Vite dev server.
BETTER_AUTH_URL=http://localhost:5173
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backend (FastAPI) ---
# Dev port, read by uvicorn.
UVICORN_PORT=8000
# Where the backend fetches the auth service public keys. Must match AUTH_PORT.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# --- Production only (compose.prod.yml) ---
DOMAIN=
ACME_EMAIL=

# --- Optional isolated water-model paths (defaults resolve inside apps/backend) ---
# WATER_MODELS_DIR=/absolute/path/to/models/water-v1
# WATER_DATA_DIR=/absolute/path/to/data/water-v1
# WATER_ENVIRONMENT=/absolute/path/to/.venv-models

# --- Optional crop-map release path (default: apps/backend/data/crops) ---
# CROP_MAP_DIR=/absolute/path/to/data/crops

# --- Optional rotation-simulator paths (defaults resolve inside apps/backend) ---
# ROTATION_SIM_DATA_DIR=/absolute/path/to/data/rotation-sim
# ROTATION_SIM_CONFIG_DIR=/absolute/path/to/vendor/rotation-sim/configs
